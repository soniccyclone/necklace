
# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Node
node_modules/

# Beads workspace. Only the exported graph is tracked: bead IDs in
# .necklace/*/cuj.md have to resolve for anyone reading the repo without bd.
.beads/*
!.beads/issues.jsonl

# Agent instruction files generated by `bd init`. They describe beads, not
# necklace, and .claude/settings.json fires a bd hook at anyone who clones.
# Delete these three lines if necklace ever wants its own CLAUDE.md or AGENTS.md.
.agents/
.claude/settings.json
/AGENTS.md
/CLAUDE.md

# Scratch environments inside planning directories. The scripts are kept; the
# environments that ran them are not.
.necklace/**/repl/.venv/
.necklace/**/repl/__pycache__/

# Built site output. Regenerated on every publish; never reviewed as a diff.
.necklace/**/repl/**/www/

# Generated from the real SKILL.md files at build time.
.necklace/**/repl/**/gen/

# Site build artifacts. Generated from skills/ and org/ on every build.
site/www/
site/gen/
site/org/skill-*.org

# REPL scratch: the demo installs prompt libraries to compare against.
.necklace/**/repl/node_modules/
.necklace/**/repl/package-lock.json

# Beads / Dolt files (added by bd init)
*.gate.lock*
